{
  "name": "@donna/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative relational schema (Drizzle) and migrations for the DONNA V2 control plane.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "pnpm run build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "node dist/bin/migrate.js"
  },
  "dependencies": {
    "@donna/core-domain": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1"
  }
}
