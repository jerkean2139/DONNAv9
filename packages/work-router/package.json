  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@donna/core-domain": "workspace:*",
    "@donna/adapter-base": "workspace:*"
  }
}
