{
  "name": "@donna/work-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Work Router for DONNA V2 — selects the execution class above the Model Router.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
