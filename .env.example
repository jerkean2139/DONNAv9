# DONNA V2 — environment variable NAMES only.
# Copy to `.env` for local dev and fill with LOCAL/DEV values.
# NEVER commit a real .env. Secrets live in a secrets manager in DEV/STAGING/PROD
# (Technical Plan §8): they never enter source control, logs, prompts, artifacts,
# or semantic memory.

# --- Environment ---------------------------------------------------------
# One of: local | dev | staging | production
DONNA_ENV=local

# --- Database (authoritative relational state) ---------------------------
# Local dev uses the docker-compose Postgres+pgvector in infra/docker.
DATABASE_URL=postgresql://donna:donna@localhost:5432/donna

# --- Auth (server-side; MFA required per §8) -----------------------------
# Filled in a later phase. Names reserved here for convention.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never shipped to the browser

# --- Model providers (accessed only through adapters, §7) ----------------
# Real keys belong in the secrets manager, not here.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Local compute mesh (§9) ---------------------------------------------
# Node service identity / mesh config are added when the node-agent lands.
# DONNA_NODE_SHARED_SECRET=

# --- Observability (§15) -------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=
